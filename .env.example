# Safe to expose: these are meant to reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://iwjkjfluynwhpangdyrm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# NEVER put these in this file, in the repo, or in any NEXT_PUBLIC_ variable.
# They live only in Supabase Edge Function secrets:
#   SUPABASE_SERVICE_ROLE_KEY
#   VAPID_PRIVATE_KEY

# Web push.
#
# VAPID_PUBLIC_KEY is read on the server and handed to the browser as a prop,
# so it needs no NEXT_PUBLIC_ prefix and no rebuild when it changes. The
# NEXT_PUBLIC_ spelling is still accepted if that is what you already have.
#
# VAPID_PRIVATE_KEY signs every delivery. Server only: never prefixed, never
# committed, never logged.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
